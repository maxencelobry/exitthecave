# France Travail API credentials
FRANCE_TRAVAIL_CLIENT_ID=your_client_id
FRANCE_TRAVAIL_CLIENT_SECRET=your_client_secret
# Optional: use the JSON export received from France Travail instead.
FRANCE_TRAVAIL_CREDENTIALS_FILE=C:/path/to/france-travail-credentials.json

# PostgreSQL / Supabase (server-side only; never expose this in the frontend)
DATABASE_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres
DATABASE_POOL_MAX=10
HOST=127.0.0.1
PORT=3000
